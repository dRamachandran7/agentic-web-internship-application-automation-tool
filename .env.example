# Copy to .env before running `docker compose up`. Compose reads this file
# automatically; the per-service .env files are only used by the non-Docker
# setup described in each service's README.

# Required by analyze_listing and personalize_resume.
# Free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional overrides -----------------------------------------------------

# Groq model used by both LLM services.
# GROQ_MODEL=llama-3.3-70b-versatile

# Handshake base URL and scrape tuning (search_listings).
# HANDSHAKE_BASE_URL=https://app.joinhandshake.com
# NAV_TIMEOUT_MS=30000
# MAX_LISTINGS=25

# Seconds Tectonic gets to compile one resume (personalize_resume).
# COMPILE_TIMEOUT_S=60

# How long the frontend waits on any single backend call, in milliseconds.
# REQUEST_TIMEOUT_MS=120000
